// Platform-owned tables. No organization_id and no RLS: they belong to a person or to
// the platform itself, not to a tenant. The API reaches them only through the auth module.

enum IdentityStatus {
  ACTIVE
  DISABLED
}

enum SessionRealm {
  STAFF
  GUEST
}

enum MfaFactorType {
  TOTP
}

/// A person's login. One identity can be a member of several organizations.
model Identity {
  id               String         @id @default(uuid(7)) @db.Uuid
  email            String         @unique @db.Citext
  displayName      String         @map("display_name")
  status           IdentityStatus @default(ACTIVE)
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential  IdentityCredential?
  mfaFactors  MfaFactor[]
  sessions    Session[]
  memberships OrganizationMembership[]

  @@map("identities")
}

/// Kept apart from `identities` so a routine identity query can never select a hash.
model IdentityCredential {
  identityId        String   @id @map("identity_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("identity_credentials")
}

model MfaFactor {
  id              String        @id @default(uuid(7)) @db.Uuid
  identityId      String        @map("identity_id") @db.Uuid
  type            MfaFactorType
  /// Envelope-encrypted secret (ADR-0006). Never stored or logged in plaintext.
  secretEncrypted Bytes         @map("secret_encrypted")
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  lastUsedStep    BigInt?       @map("last_used_step")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("mfa_factors")
}

/// Opaque server-side session. Only the SHA-256 of the token is stored.
model Session {
  id                   String       @id @default(uuid(7)) @db.Uuid
  tokenHash            String       @unique @map("token_hash")
  realm                SessionRealm @default(STAFF)
  identityId           String       @map("identity_id") @db.Uuid
  activeOrganizationId String?      @map("active_organization_id") @db.Uuid
  mfaVerifiedAt        DateTime?    @map("mfa_verified_at") @db.Timestamptz(3)
  ip                   String?      @db.Inet
  userAgent            String?      @map("user_agent")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt           DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt        DateTime     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt    DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedReason        String?      @map("revoked_reason")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("sessions")
}

/// Seeded from @hotel/contracts PERMISSIONS. Never edited at runtime.
model Permission {
  code        String      @id
  description String
  scopes      ScopeType[]
  sensitive   Boolean     @default(false)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Seeded from @hotel/contracts ROLE_TEMPLATES.
model RoleTemplate {
  key         String   @id
  name        String
  description String
  permissions String[]

  @@map("role_templates")
}

model FeatureFlagDefinition {
  key            String  @id
  description    String
  defaultEnabled Boolean @default(false) @map("default_enabled")

  organizationFlags OrganizationFeatureFlag[]

  @@map("feature_flag_definitions")
}
