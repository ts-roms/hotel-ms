// Operations (blueprint §6.1): housekeeping tasks, guest service requests, maintenance
// requests and lost and found.

enum HousekeepingTaskType {
  CHECKOUT_CLEAN
  STAYOVER
  TOUCH_UP
  INSPECTION
}

enum HousekeepingTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ServiceRequestSource {
  GUEST
  STAFF
}

enum ServiceRequestStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model HousekeepingTask {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  propertyId           String                 @map("property_id") @db.Uuid
  roomId               String                 @map("room_id") @db.Uuid
  type                 HousekeepingTaskType
  status               HousekeepingTaskStatus @default(OPEN)
  businessDate         DateTime               @map("business_date") @db.Date
  assignedMembershipId String?                @map("assigned_membership_id") @db.Uuid
  notes                String                 @default("")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt            DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdBy            String?                @map("created_by") @db.Uuid
  version              Int                    @default(1)

  room     Room                    @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Restrict)
  assignee OrganizationMembership? @relation(fields: [organizationId, assignedMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, propertyId, businessDate])
  @@index([organizationId, assignedMembershipId, status])
  @@index([organizationId, roomId])
  @@map("housekeeping_tasks")
}

model ServiceRequest {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  propertyId           String                 @map("property_id") @db.Uuid
  requestNo            String                 @map("request_no")
  source               ServiceRequestSource
  category             String
  department           String
  priority             ServiceRequestPriority @default(NORMAL)
  description          String                 @default("")
  status               ServiceRequestStatus   @default(OPEN)
  reservationRoomId    String?                @map("reservation_room_id") @db.Uuid
  roomId               String?                @map("room_id") @db.Uuid
  guestId              String?                @map("guest_id") @db.Uuid
  assignedMembershipId String?                @map("assigned_membership_id") @db.Uuid
  rating               Int?
  feedback             String?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  acknowledgedAt       DateTime?              @map("acknowledged_at") @db.Timestamptz(3)
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdBy            String?                @map("created_by") @db.Uuid
  version              Int                    @default(1)

  room        Room?                   @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Restrict)
  maintenance MaintenanceRequest[]
  guest       Guest?                  @relation(fields: [organizationId, guestId], references: [organizationId, id], onDelete: Restrict)
  assignee    OrganizationMembership? @relation(fields: [organizationId, assignedMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([propertyId, requestNo])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, reservationRoomId])
  @@map("service_requests")
}

/// Maintenance requests (spec §32, ADR-0023). A request may take its room out of order
/// through an out-of-order block (room_assignments, kind BLOCK), released when it closes.
model MaintenanceRequest {
  id                   String    @id @default(uuid(7)) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  propertyId           String    @map("property_id") @db.Uuid
  requestNo            String    @map("request_no")
  roomId               String?   @map("room_id") @db.Uuid
  location             String?
  category             String
  priority             String
  status               String    @default("OPEN")
  title                String
  description          String    @default("")
  reportedBy           String?   @map("reported_by") @db.Uuid
  assignedMembershipId String?   @map("assigned_membership_id") @db.Uuid
  serviceRequestId     String?   @map("service_request_id") @db.Uuid
  blockId              String?   @map("block_id") @db.Uuid
  resolution           String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt            DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int       @default(1)

  property       Property                @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  room           Room?                   @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Restrict)
  assignee       OrganizationMembership? @relation(fields: [organizationId, assignedMembershipId], references: [organizationId, id], onDelete: Restrict)
  serviceRequest ServiceRequest?         @relation(fields: [organizationId, serviceRequestId], references: [organizationId, id], onDelete: Restrict)
  block          RoomAssignment?         @relation(fields: [blockId], references: [id], onDelete: Restrict)
  updates        MaintenanceUpdate[]
  photos         MaintenancePhoto[]

  @@unique([organizationId, id])
  @@unique([propertyId, requestNo])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, roomId])
  @@map("maintenance_requests")
}

/// Append-only history of a request: creation, assignment, status changes, notes, photos.
model MaintenanceUpdate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  kind           String
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  note           String?
  actorId        String?  @map("actor_id") @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz(3)

  request MaintenanceRequest @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, requestId, at])
  @@map("maintenance_updates")
}

model MaintenancePhoto {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  storageKey     String   @unique @map("storage_key")
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  sha256         String   @db.Char(64)
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request MaintenanceRequest @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, requestId])
  @@map("maintenance_photos")
}

/// Lost & found (spec §31): held items, then returned to their owner or disposed of.
model LostFoundItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  itemNo          String    @map("item_no")
  description     String
  category        String
  foundAt         DateTime  @map("found_at") @db.Timestamptz(3)
  foundLocation   String    @map("found_location")
  roomId          String?   @map("room_id") @db.Uuid
  storageLocation String    @map("storage_location")
  foundBy         String?   @map("found_by") @db.Uuid
  status          String    @default("HELD")
  closingNote     String?   @map("closing_note")
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy        String?   @map("closed_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  version         Int       @default(1)

  property Property @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  room     Room?    @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([propertyId, itemNo])
  @@index([organizationId, propertyId, status])
  @@map("lost_found_items")
}
