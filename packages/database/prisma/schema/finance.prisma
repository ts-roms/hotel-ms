// Finance (blueprint §15): folios and their append-only ledger, payments, online payment
// intents and webhooks, refunds, cashier shifts, invoices and receipts, folio routing.

enum FolioStatus {
  OPEN
  CLOSED
}

enum FolioLineType {
  /// Net amount of a charge (tax is posted as separate TAX lines).
  CHARGE
  TAX
  /// Negative: money received.
  PAYMENT
  /// Signed correction after the business day closed (needs folio.adjust).
  ADJUSTMENT
  /// Exact negation of an earlier line, same business day only.
  REVERSAL
  /// Positive: money given back to the payer.
  REFUND
  /// Balance moved between folios, always posted in pairs.
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  EWALLET
  OTHER
}

enum PaymentIntentStatus {
  PENDING
  /// A card hold is in place (pre-authorization); nothing captured yet.
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  /// Valid but nothing to do (duplicate outcome, unknown reference).
  IGNORED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CashierShiftStatus {
  OPEN
  CLOSED
}

enum FolioDocumentType {
  INVOICE
  RECEIPT
}

model Folio {
  id                  String      @id @default(uuid(7)) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  propertyId          String      @map("property_id") @db.Uuid
  folioNo             String      @map("folio_no")
  reservationRoomId   String?     @map("reservation_room_id") @db.Uuid
  /// Company / group account name; null for guest folios.
  label               String?
  /// Statutory discount applied to this folio's charges.
  discountProfileId   String?     @map("discount_profile_id") @db.Uuid
  discountHolderName  String?     @map("discount_holder_name")
  discountIdLast4     String?     @map("discount_id_last4") @db.VarChar(4)
  /// The holder's ID number, encrypted (SecretBox, blueprint §20.3).
  discountIdEncrypted Bytes?      @map("discount_id_encrypted")
  status              FolioStatus @default(OPEN)
  currency            String      @db.Char(3)
  /// Cached SUM(folio_lines.amount_minor), updated in the posting transaction.
  balanceMinor        BigInt      @default(0) @map("balance_minor")
  openedAt            DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt            DateTime?   @map("closed_at") @db.Timestamptz(3)
  version             Int         @default(1)

  reservationRoom ReservationRoom?   @relation(fields: [organizationId, reservationRoomId], references: [organizationId, id], onDelete: Restrict)
  lines           FolioLine[]
  payments        Payment[]
  paymentIntents  PaymentIntent[]
  discountProfile DiscountProfile?   @relation(fields: [organizationId, discountProfileId], references: [organizationId, id], onDelete: Restrict)
  documents       FolioDocument[]
  routingRules    FolioRoutingRule[] @relation("RoutingSource")
  routedFrom      FolioRoutingRule[] @relation("RoutingTarget")

  @@unique([organizationId, id])
  @@unique([propertyId, folioNo])
  @@map("folios")
}

/// Append-only ledger (§15.1): corrections are new lines, never edits or deletes.
model FolioLine {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  propertyId     String        @map("property_id") @db.Uuid
  folioId        String        @map("folio_id") @db.Uuid
  businessDate   DateTime      @map("business_date") @db.Date
  type           FolioLineType
  department     String
  description    String
  /// Signed minor units: charges and taxes positive, payments negative.
  amountMinor    BigInt        @map("amount_minor")
  currency       String        @db.Char(3)
  /// TAX lines point at their CHARGE/ADJUSTMENT line.
  parentLineId   String?       @map("parent_line_id") @db.Uuid
  reversesLineId String?       @map("reverses_line_id") @db.Uuid
  /// Pairs the two sides of a TRANSFER.
  transferId     String?       @map("transfer_id") @db.Uuid
  taxCode        String?       @map("tax_code")
  /// Idempotency within the folio (e.g. "room:<line>:<date>" for night-audit room charges).
  sourceKey      String?       @map("source_key")
  reason         String?
  postedBy       String?       @map("posted_by") @db.Uuid
  postedAt       DateTime      @default(now()) @map("posted_at") @db.Timestamptz(3)

  folio Folio @relation(fields: [organizationId, folioId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([folioId, sourceKey])
  @@index([organizationId, folioId, postedAt])
  @@index([organizationId, propertyId, businessDate])
  @@map("folio_lines")
}

model Payment {
  id                  String        @id @default(uuid(7)) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  propertyId          String        @map("property_id") @db.Uuid
  folioId             String        @map("folio_id") @db.Uuid
  folioLineId         String        @map("folio_line_id") @db.Uuid
  method              PaymentMethod
  amountMinor         BigInt        @map("amount_minor")
  currency            String        @db.Char(3)
  /// Card terminal / transfer / e-wallet reference. Never card numbers.
  reference           String?
  businessDate        DateTime      @map("business_date") @db.Date
  receivedBy          String?       @map("received_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Online gateway and its reference, for payments taken through a payment intent.
  provider            String?
  intentId            String?       @unique @map("intent_id") @db.Uuid
  cashierShiftId      String?       @map("cashier_shift_id") @db.Uuid
  /// Foreign cash: what was handed over, and the rate used (property currency x 1e6).
  tenderedCurrency    String?       @map("tendered_currency") @db.Char(3)
  tenderedAmountMinor BigInt?       @map("tendered_amount_minor")
  exchangeRateMicros  BigInt?       @map("exchange_rate_micros")

  folio        Folio         @relation(fields: [organizationId, folioId], references: [organizationId, id], onDelete: Restrict)
  cashierShift CashierShift? @relation(fields: [organizationId, cashierShiftId], references: [organizationId, id], onDelete: Restrict)
  refunds      Refund[]

  @@unique([organizationId, id])
  @@index([organizationId, propertyId, businessDate])
  @@index([organizationId, folioId])
  @@map("payments")
}

/// A request to collect money through an online gateway. The folio PAYMENT line is posted
/// only when the provider confirms success (webhook).
model PaymentIntent {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  propertyId        String              @map("property_id") @db.Uuid
  /// Null for a hold placed before the stay's folio exists.
  folioId           String?             @map("folio_id") @db.Uuid
  reservationRoomId String?             @map("reservation_room_id") @db.Uuid
  /// PAYMENT or HOLD.
  kind              String              @default("PAYMENT")
  capturedMinor     BigInt              @default(0) @map("captured_minor")
  provider          String
  /// The provider's id for the checkout; unique per provider across all tenants.
  providerRef       String?             @map("provider_ref")
  amountMinor       BigInt              @map("amount_minor")
  currency          String              @db.Char(3)
  status            PaymentIntentStatus @default(PENDING)
  checkoutUrl       String?             @map("checkout_url")
  returnUrl         String              @map("return_url")
  source            String
  createdBy         String?             @map("created_by") @db.Uuid
  guestSessionId    String?             @map("guest_session_id") @db.Uuid
  paymentId         String?             @map("payment_id") @db.Uuid
  needsAttention    Boolean             @default(false) @map("needs_attention")
  failureReason     String?             @map("failure_reason")
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  folio Folio? @relation(fields: [organizationId, folioId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([provider, providerRef])
  @@index([organizationId, reservationRoomId])
  @@index([organizationId, folioId])
  @@map("payment_intents")
}

/// Webhook inbox: every provider event, stored before processing. Platform-level (the
/// tenant is only known after resolving the reference); UNIQUE (provider, event_id)
/// makes redelivered events no-ops.
model WebhookEvent {
  id             String             @id @default(uuid(7)) @db.Uuid
  provider       String
  eventId        String             @map("event_id")
  eventType      String             @map("event_type")
  signatureValid Boolean            @map("signature_valid")
  payload        Json
  status         WebhookEventStatus @default(RECEIVED)
  attempts       Int                @default(0)
  lastError      String?            @map("last_error")
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  folioId        String       @map("folio_id") @db.Uuid
  folioLineId    String?      @map("folio_line_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor")
  reason         String
  status         RefundStatus
  provider       String?
  providerRef    String?      @map("provider_ref")
  cashierShiftId String?      @map("cashier_shift_id") @db.Uuid
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, paymentId])
  @@map("refunds")
}

model CashierShift {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  propertyId        String             @map("property_id") @db.Uuid
  membershipId      String             @map("membership_id") @db.Uuid
  status            CashierShiftStatus @default(OPEN)
  openedAt          DateTime           @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingFloatMinor BigInt             @map("opening_float_minor")
  closedAt          DateTime?          @map("closed_at") @db.Timestamptz(3)
  expectedCashMinor BigInt?            @map("expected_cash_minor")
  countedCashMinor  BigInt?            @map("counted_cash_minor")
  varianceMinor     BigInt?            @map("variance_minor")
  notes             String             @default("")
  version           Int                @default(1)

  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  payments   Payment[]

  @@unique([organizationId, id])
  @@index([organizationId, propertyId, status])
  @@map("cashier_shifts")
}

/// Invoices and receipts: immutable, gap-free numbered per property and type.
model FolioDocument {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  propertyId     String            @map("property_id") @db.Uuid
  folioId        String            @map("folio_id") @db.Uuid
  type           FolioDocumentType
  documentNo     String            @map("document_no")
  paymentId      String?           @map("payment_id") @db.Uuid
  currency       String            @db.Char(3)
  totalMinor     BigInt            @map("total_minor")
  content        Json
  issuedBy       String?           @map("issued_by") @db.Uuid
  issuedAt       DateTime          @default(now()) @map("issued_at") @db.Timestamptz(3)

  folio Folio @relation(fields: [organizationId, folioId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([propertyId, type, documentNo])
  @@index([organizationId, folioId])
  @@map("folio_documents")
}

/// Charges of these departments posted to the source folio go to the target instead
/// (e.g. the company pays the room, the guest pays incidentals).
model FolioRoutingRule {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  sourceFolioId  String    @map("source_folio_id") @db.Uuid
  targetFolioId  String    @map("target_folio_id") @db.Uuid
  departments    String[]
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  source Folio @relation("RoutingSource", fields: [organizationId, sourceFolioId], references: [organizationId, id], onDelete: Restrict)
  target Folio @relation("RoutingTarget", fields: [organizationId, targetFolioId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, sourceFolioId])
  @@map("folio_routing_rules")
}

/// Result of the nightly automatic reconciliation (one per property and local date).
model ReconciliationRun {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  runDate        DateTime @map("run_date") @db.Date
  ok             Boolean
  issues         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@unique([propertyId, runDate])
  @@map("reconciliation_runs")
}

/// Exchange rates for foreign cash (history; the latest effective one applies).
model ExchangeRate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  currency       String   @db.Char(3)
  /// Property currency units per 1 unit of `currency`, times 1,000,000.
  rateMicros     BigInt   @map("rate_micros")
  effectiveFrom  DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  @@unique([organizationId, id])
  @@index([propertyId, currency, effectiveFrom])
  @@map("exchange_rates")
}

/// Statutory discount profiles (e.g. PH senior citizen / PWD): configuration, not code.
model DiscountProfile {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  code           String
  name           String
  discountBps    Int       @map("discount_bps")
  exemptTaxCodes String[]  @map("exempt_tax_codes")
  departments    String[]
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  folios Folio[]

  @@unique([organizationId, id])
  @@unique([propertyId, code])
  @@map("discount_profiles")
}
