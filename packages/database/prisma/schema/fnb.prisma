// F&B (blueprint §14): outlets, menus with modifiers, orders with price and tax snapshots,
// and the order event history.

enum OutletType {
  RESTAURANT
  BAR
  CAFE
  ROOM_SERVICE
}

enum ChargeMethod {
  /// Posted to the in-house guest's folio on delivery.
  ROOM_CHARGE
  PAY_ON_DELIVERY
  PAY_AT_OUTLET
}

enum OrderSource {
  GUEST
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Outlet {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  propertyId      String     @map("property_id") @db.Uuid
  code            String
  name            String
  type            OutletType
  /// Takes room-service orders from the guest portal.
  roomService     Boolean    @default(false) @map("room_service")
  allowRoomCharge Boolean    @default(true) @map("allow_room_charge")
  /// Property-local "HH:mm"; both null = always open. A close before the open wraps midnight.
  opensAt         String?    @map("opens_at") @db.VarChar(5)
  closesAt        String?    @map("closes_at") @db.VarChar(5)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  version         Int        @default(1)

  property   Property       @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]

  @@unique([organizationId, id])
  @@unique([propertyId, code])
  @@map("outlets")
}

model MenuCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  outletId       String    @map("outlet_id") @db.Uuid
  name           String
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  outlet Outlet     @relation(fields: [organizationId, outletId], references: [organizationId, id], onDelete: Restrict)
  items  MenuItem[]

  @@unique([organizationId, id])
  @@index([organizationId, outletId])
  @@map("menu_categories")
}

model MenuItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  outletId       String    @map("outlet_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  name           String
  description    String    @default("")
  /// Property currency, as charged (tax-inclusive where FNB taxes are inclusive).
  priceMinor     BigInt    @map("price_minor")
  available      Boolean   @default(true)
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  version        Int       @default(1)
  /// The item's photo (ADR-0030): WebP in object storage; the hash is its version.
  imageKey       String?   @map("image_key")
  imageSha256    String?   @map("image_sha256") @db.Char(64)

  outlet         Outlet          @relation(fields: [organizationId, outletId], references: [organizationId, id], onDelete: Restrict)
  category       MenuCategory    @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@unique([organizationId, id])
  @@index([organizationId, outletId])
  @@map("menu_items")
}

model ModifierGroup {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  menuItemId     String @map("menu_item_id") @db.Uuid
  name           String
  minSelect      Int    @default(0) @map("min_select")
  maxSelect      Int    @default(1) @map("max_select")
  sortOrder      Int    @default(0) @map("sort_order")

  menuItem  MenuItem   @relation(fields: [organizationId, menuItemId], references: [organizationId, id], onDelete: Restrict)
  modifiers Modifier[]

  @@unique([organizationId, id])
  @@index([organizationId, menuItemId])
  @@map("modifier_groups")
}

model Modifier {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  name           String
  priceMinor     BigInt @default(0) @map("price_minor")
  sortOrder      Int    @default(0) @map("sort_order")

  group ModifierGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, groupId])
  @@map("modifiers")
}

model Order {
  id                String       @id @default(uuid(7)) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  propertyId        String       @map("property_id") @db.Uuid
  outletId          String       @map("outlet_id") @db.Uuid
  orderNo           String       @map("order_no")
  source            OrderSource
  status            OrderStatus
  chargeMethod      ChargeMethod @map("charge_method")
  roomId            String?      @map("room_id") @db.Uuid
  reservationRoomId String?      @map("reservation_room_id") @db.Uuid
  guestId           String?      @map("guest_id") @db.Uuid
  currency          String       @db.Char(3)
  subtotalMinor     BigInt       @map("subtotal_minor")
  addedTaxMinor     BigInt       @map("added_tax_minor")
  totalMinor        BigInt       @map("total_minor")
  /// FNB tax rules in force when the order was placed; the folio posting uses these.
  taxRules          Json         @map("tax_rules")
  notes             String       @default("")
  folioId           String?      @map("folio_id") @db.Uuid
  folioLineId       String?      @map("folio_line_id") @db.Uuid
  chargedAt         DateTime?    @map("charged_at") @db.Timestamptz(3)
  cancelReason      String?      @map("cancel_reason")
  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdBy         String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int          @default(1)

  outlet Outlet       @relation(fields: [organizationId, outletId], references: [organizationId, id], onDelete: Restrict)
  room   Room?        @relation(fields: [organizationId, roomId], references: [organizationId, id], onDelete: Restrict)
  guest  Guest?       @relation(fields: [organizationId, guestId], references: [organizationId, id], onDelete: Restrict)
  items  OrderItem[]
  events OrderEvent[]

  @@unique([organizationId, id])
  @@unique([propertyId, orderNo])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, outletId, status])
  @@index([organizationId, reservationRoomId])
  @@map("orders")
}

/// Price snapshot: later menu edits never change an order.
model OrderItem {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  menuItemId     String @map("menu_item_id") @db.Uuid
  name           String
  quantity       Int
  unitPriceMinor BigInt @map("unit_price_minor")
  /// [{ name, priceMinor }] as chosen.
  modifiers      Json
  lineTotalMinor BigInt @map("line_total_minor")
  notes          String @default("")

  order    Order    @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [organizationId, menuItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, orderId])
  @@map("order_items")
}

/// Every status change, append-only.
model OrderEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  fromStatus     OrderStatus? @map("from_status")
  toStatus       OrderStatus  @map("to_status")
  actorType      ActorType    @map("actor_type")
  actorId        String?      @map("actor_id") @db.Uuid
  note           String?
  at             DateTime     @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, orderId])
  @@map("order_events")
}
