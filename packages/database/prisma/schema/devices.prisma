/// Shared devices (ADR-0020): e.g. a kitchen tablet paired to one property. The device
/// authenticates with a long-lived token (cookie); staff sign in on it with a PIN.
model Device {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  name             String
  /// KITCHEN or TIME_CLOCK (ADR-0022).
  kind             String    @default("KITCHEN")
  permissions      String[]
  /// SHA-256 of the device token; null until paired.
  tokenHash        String?   @unique @map("token_hash")
  /// SHA-256 of the one-time pairing code, while a pairing is open.
  pairingCodeHash  String?   @unique @map("pairing_code_hash")
  pairingExpiresAt DateTime? @map("pairing_expires_at") @db.Timestamptz(3)
  pairedAt         DateTime? @map("paired_at") @db.Timestamptz(3)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property          @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  sessions DeviceSession[]
  photos   AttendancePhoto[]

  @@unique([organizationId, id])
  @@index([organizationId, propertyId])
  @@map("devices")
}

/// A member's PIN for signing in on shared devices. Hashed like a password; locked after
/// repeated failures.
model StaffPin {
  membershipId   String    @id @map("membership_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pinHash        String    @map("pin_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@map("staff_pins")
}

/// An operator signed in on a device. Short-lived: idle and absolute limits.
model DeviceSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)

  device     Device                 @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Restrict)
  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, deviceId])
  @@map("device_sessions")
}
