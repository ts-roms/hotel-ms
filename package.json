{
  "name": "hotel-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && pnpm lint:deps",
    "lint:deps": "depcruise apps/api/src apps/worker/src apps/web/src apps/guest/src packages/api-client/src packages/contracts/src packages/database/src packages/format/src packages/i18n/src packages/ui/src --config .dependency-cruiser.cjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @hotel/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @hotel/database migrate:dev",
    "db:seed": "turbo run build --filter=@hotel/database && pnpm --filter @hotel/database seed",
    "db:reset": "turbo run build --filter=@hotel/database && pnpm --filter @hotel/database reset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
