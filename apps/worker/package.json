{
  "name": "@hotel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@aws-sdk/client-sns": "^3.1141.0",
    "@hotel/contracts": "workspace:*",
    "@hotel/database": "workspace:*",
    "@hotel/format": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@sentry/node": "^11.0.0",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dotenv": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.2"
  }
}
