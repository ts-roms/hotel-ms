{
  "name": "@hotel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hotel/contracts": "workspace:*",
    "@hotel/database": "workspace:*",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dotenv": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.2"
  }
}
