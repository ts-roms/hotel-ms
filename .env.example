# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development

# Migrations / schema owner (never used by the running app)
DATABASE_OWNER_URL=postgresql://hotel_owner:hotel_owner@localhost:55432/hotel
# Runtime tenant role (RLS enforced)
DATABASE_URL=postgresql://hotel_app:hotel_app@localhost:55432/hotel
# Cross-tenant system jobs only (outbox relay, schedulers)
DATABASE_SYSTEM_URL=postgresql://hotel_system:hotel_system@localhost:55432/hotel

REDIS_CACHE_URL=redis://localhost:56379
REDIS_QUEUE_URL=redis://localhost:56380

API_PORT=48100
API_PUBLIC_ORIGIN=http://localhost:48100
WEB_ORIGIN=http://localhost:43100
# Used to sign CSRF tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-in-dev-only-000000000000000
# Public URL of the staff web app, used in emailed links.
APP_PUBLIC_URL=http://localhost:43100
# Guest portal: allowed Origin for guest requests, and the public URL used in emailed links.
GUEST_ORIGIN=http://localhost:43200
GUEST_PUBLIC_URL=http://localhost:43200
# Online payments (ADR-0016). The built-in sandbox gateway is on by default outside production.
# PAYMENT_PROVIDER=sandbox
# PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_SECRET=sandbox-webhook-secret-dev-only
# AES-256-GCM keys for sensitive columns (MFA secrets): kid:base64(32 bytes)[,older...]
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=dev1:REPLACE_WITH_32_BYTES_BASE64
# Uploaded files (employee documents): local (development) | s3 (SSE-KMS, required in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# STORAGE_BUCKET=
# STORAGE_KMS_KEY_ID=
# AWS_REGION=ap-southeast-1
# Email: file (writes to MAIL_DIR, development only) | ses
EMAIL_TRANSPORT=file
MAIL_DIR=.mail
EMAIL_FROM=Hotel Platform <no-reply@hotel-platform.local>
LOG_LEVEL=debug
