# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development

# Migrations / schema owner (never used by the running app)
DATABASE_OWNER_URL=postgresql://hotel_owner:hotel_owner@localhost:55432/hotel
# Runtime tenant role (RLS enforced)
DATABASE_URL=postgresql://hotel_app:hotel_app@localhost:55432/hotel
# Cross-tenant system jobs only (outbox relay, schedulers)
DATABASE_SYSTEM_URL=postgresql://hotel_system:hotel_system@localhost:55432/hotel

REDIS_CACHE_URL=redis://localhost:56379
REDIS_QUEUE_URL=redis://localhost:56380

API_PORT=48100
API_PUBLIC_ORIGIN=http://localhost:48100
WEB_ORIGIN=http://localhost:43100
# Used to sign CSRF tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-in-dev-only-000000000000000
LOG_LEVEL=debug
